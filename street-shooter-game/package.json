    "test": "vitest run",
    "electron": "electron ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^10.0.0",
    "electron": "^34.0.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.1"
  }
}
